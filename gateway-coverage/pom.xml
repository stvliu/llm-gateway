<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codingas.gateway</groupId>
        <artifactId>gateway-project</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>com.codingas.gateway</groupId>
    <artifactId>gateway-coverage</artifactId>
    <packaging>pom</packaging>
    <name>Gateway Coverage</name>
    <description>覆盖率聚合模块：声明全部子模块为 provided 依赖，由本模块自声明的 jacoco report-aggregate（verify 阶段执行）聚合全模块覆盖率报告</description>

    <!--
        聚合依赖：jacoco report-aggregate 只聚合「当前项目声明为依赖的模块」。
        根 pom 无法声明子模块依赖（<dependencies> 被子模块继承导致自引用），
        故放在本模块自己的 pom 中——兄弟模块不会继承本模块的 dependencies。
        provided scope：仅为 report-aggregate 的依赖解析提供目标，不产生传递依赖。
    -->
