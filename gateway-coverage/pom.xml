    <!--
        report-aggregate 只在本模块声明执行（根 pom build/plugins 已移除该 execution，
        子模块继承的只有 prepare-agent/report 单模块覆盖率）。
        聚合报告为权威全模块覆盖率，产出在 target/site/jacoco-aggregate/。
        version 从根 pluginManagement 继承；excludes 等 configuration 同样继承，
        聚合无需额外 configuration。
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
