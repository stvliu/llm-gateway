            <artifactId>gateway-iam</artifactId>
            <version>${revision}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-iam-data</artifactId>
            <version>${revision}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
