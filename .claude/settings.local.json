{
  "env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Bash(*)",
      "PowerShell",
      "Read(E:/workspace/llm-gateway/**)",
      "Edit(E:/workspace/llm-gateway/**)",
      "Read(//e/workspace/**)",
      "Read(//mnt/e/workspace/llm-gateway/**)",
      "Read(//c/Users/liuye/.claude/**)",
      "Edit(//c/Users/liuye/.claude/**)",
      "Read(//c/Users/liuye/.m2/repository/**)",
      "Read(//d/Java/**)",
      "Read(//tmp/**)",
      "mcp__codegraph",
      "WebSearch",
      "WebFetch(domain:mvnrepository.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:jreleaser.org)",
      "WebFetch(domain:repo.maven.apache.org)",
      "Skill(fewer-permission-prompts)",
      "Skill(openspec-propose)",
      "Skill(openspec-apply-change)",
      "Skill(update-config)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(cd * && rm -rf *)",
      "Bash(cd * && rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(cd * && git push --force*)",
      "Bash(cd * && git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(cd * && git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(drop database *)",
      "Bash(drop table *)",
      "Bash(truncate table *)",
      "Bash(shutdown *)",
      "Bash(reboot *)"
    ]
  },
  "askUserQuestionTimeout": "60s",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skillOverrides": {
    "brainstorming": "user-invocable-only"
  },
  "outputStyle": "default"
}
