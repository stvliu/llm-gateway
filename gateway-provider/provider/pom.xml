<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codingas.gateway</groupId>
        <artifactId>gateway-project</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <groupId>com.codingas.gateway</groupId>
    <artifactId>gateway-provider</artifactId>
    <packaging>jar</packaging>
    <name>Gateway Provider</name>
    <description>供给域：Provider/Channel/Model/Catalog/Credential/Endpoint/Upstream/RoutingContext（由 domain.supply 迁入）</description>
    <dependencies>
        <!-- 横切底座 -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring Boot Actuator（ProviderHealth 健康状态类型，供域内健康监控与 boot 层 Indicator 适配） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 抽象协议层（ConnectivityTesterImpl 依赖 protocol.transport 传输 SPI） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-protocol</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 跨域门面：模型发现查询应用渠道（ModelDiscoveryService） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-iam</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 跨域门面：渠道紧急操作使用熔断管理器（ChannelEmergencyServiceImpl） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-resilience</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 跨域门面：目录自动同步读取系统设置（SystemSettingService / SyncInterval） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-settings</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 跨域门面：模型废弃/实例状态流转写管理操作审计（AuditLogRepository） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-audit</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Jackson（BuiltinDataLoader 内置数据 JSON 序列化） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
