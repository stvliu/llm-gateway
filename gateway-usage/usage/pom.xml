<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codingas.gateway.usage</groupId>
        <artifactId>gateway-usage-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>com.codingas.gateway.usage</groupId>
    <artifactId>gateway-usage</artifactId>
    <packaging>jar</packaging>
    <name>Gateway Usage</name>
    <description>用量管控域：TokenLimit/配额/用量事件/限流执行（由 domain.usage + domain.quota + application.quota 等迁入，usage↔quota 共享边界故合并）</description>
    <dependencies>
        <!-- 横切底座 -->
        <dependency>
            <groupId>com.codingas.gateway.common</groupId>
            <artifactId>gateway-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 供给域（TokenLimit 依赖 Model/Provider） -->
        <dependency>
            <groupId>com.codingas.gateway.provider</groupId>
            <artifactId>gateway-provider</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 身份与访问管理域（TokenLimit 依赖 User） -->
        <dependency>
            <groupId>com.codingas.gateway.iam</groupId>
            <artifactId>gateway-iam</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
