---
// 覆盖 Starlight Footer：保留默认文档元素（EditLink / LastUpdated / Pagination / credits），追加版权与营销链接。
// 0.40 适配：Footer 不接收 props，子组件通过 virtual:starlight/components 导入；Icon 从 @astrojs/starlight/components 导入。
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const year = new Date().getFullYear();
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />

  <div class="site-footer sl-flex">
    <span class="copyright">© {year} LLM-Gateway</span>
    <span class="links sl-flex">
      <a href="https://github.com/codingas/llm-gateway">GitHub</a>
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">粤ICP备2023085104号-1</a>
    </span>
  </div>

  {
    config.credits && (
      <a class="kudos sl-flex" href="https://starlight.astro.build">
        <Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
      </a>
    )
  }
</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 1.5rem;
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }

    .site-footer {
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--sl-color-hairline-shade);
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .links {
      gap: 1.25rem;
    }
    .links a {
      color: var(--sl-color-gray-3);
      text-decoration: none;
    }
    .links a:hover {
      color: var(--sl-color-white);
    }

    .kudos {
      align-items: center;
      gap: 0.5em;
      margin: 1.5rem auto;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
    }
    .kudos:hover {
      color: var(--sl-color-white);
    }
  }

  @layer starlight.components {
    .kudos :global(svg) {
      color: var(--sl-color-orange);
    }
  }
</style>
