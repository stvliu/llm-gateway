---
// 覆盖 Starlight Header：在默认结构（SiteTitle + Search + SocialIcons + ThemeSelect + LanguageSelect）基础上注入营销导航。
// 0.40 适配：
//   - Header 不接收 props，通过 Astro.locals / virtual:starlight/* 获取数据与子组件；
//   - 覆盖组件被注入 PageFrame 的 <header class="header">（已 fixed + 深色背景），故此处不再重复外层 header 容器，改用 flex 布局；
//   - 使用 Starlight 的 --sl-color-* 变量，确保深色主题下可见，与文档站视觉统一。
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { navigation } from '../../data/navigation';

// 当前路径判断：/en/ 前缀用英文 label（当前仅 root locale，保留以备多语言扩展）。
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en/');

// 仅在启用 pagefind 或 Search 被覆盖时渲染搜索框（与默认 Header 逻辑一致）。
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <nav class="marketing-nav sl-hidden md:sl-flex" aria-label="主导航">
    {
      navigation.map((item) => (
        <a href={item.href} class="nav-item">
          {isEn ? item.enLabel : item.label}
        </a>
      ))
    }
  </nav>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      /* 防止长标题溢出遮蔽搜索与菜单按钮。 */
      overflow: clip;
      /* 避免裁剪标题链接内部焦点环。 */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .marketing-nav {
      flex: 1;
      gap: 1.25rem;
      align-items: center;
      justify-content: center;
    }

    .nav-item {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
      text-decoration: none;
      white-space: nowrap;
    }
    .nav-item:hover {
      color: var(--sl-color-white);
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }
    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }
  }
</style>
