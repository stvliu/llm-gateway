<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.codingas.gateway</groupId>
    <artifactId>gateway-project</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>LLM-Gateway</name>
    <description>Enterprise AI Model API Gateway - OpenAI and Anthropic Compatible</description>
    <url>https://github.com/codingas/llm-gateway</url>

    <organization>
        <name>codingas.com</name>
        <url>https://codingas.com</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>gateway-common</module>
        <module>gateway-protocol/protocol</module>
        <module>gateway-protocol/protocol-openai</module>
        <module>gateway-protocol/protocol-anthropic</module>
        <module>gateway-protocol/protocol-gemini</module>
        <module>gateway-provider/provider</module>
        <module>gateway-provider/provider-data</module>
        <module>gateway-provider/provider-starter</module>
        <module>gateway-iam/iam</module>
        <module>gateway-iam/iam-data</module>
        <module>gateway-iam/iam-starter</module>
        <module>gateway-usage/usage</module>
        <module>gateway-usage/usage-data</module>
        <module>gateway-usage/usage-starter</module>
        <module>gateway-security/security</module>
        <module>gateway-security/security-data</module>
        <module>gateway-security/security-starter</module>
        <module>gateway-audit/audit</module>
        <module>gateway-audit/audit-data</module>
        <module>gateway-audit/audit-starter</module>
        <module>gateway-alert/alert</module>
        <module>gateway-alert/alert-data</module>
        <module>gateway-alert/alert-starter</module>
        <module>gateway-resilience/resilience</module>
        <module>gateway-resilience/resilience-data</module>
        <module>gateway-resilience/resilience-starter</module>
        <module>gateway-proxy/proxy</module>
        <module>gateway-proxy/proxy-starter</module>
        <module>gateway-stats/stats</module>
        <module>gateway-stats/stats-starter</module>
        <module>gateway-web</module>
        <module>gateway-boot</module>
        <module>gateway-cli</module>
        <module>gateway-simulator</module>
        <module>gateway-coverage</module>
    </modules>

    <properties>
        <!-- 项目版本 -->
        <revision>1.0.0-SNAPSHOT</revision>

        <!-- Java 配置 -->
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Boot 版本 -->
        <spring-boot.version>3.5.13</spring-boot.version>

        <!-- 第三方库版本（非 Spring Boot 生态） -->
        <redisson.version>3.52.0</redisson.version>
        <springdoc.version>2.8.4</springdoc.version>
        <sa-token.version>1.45.0</sa-token.version>
        <okhttp.version>4.12.0</okhttp.version>
        <micrometer.version>1.12.6</micrometer.version>
        <opentelemetry.version>1.47.0</opentelemetry.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <flyway.version>11.0.0</flyway.version>

        <!-- 数据库驱动版本（Flyway Maven 插件需要） -->
        <h2.version>2.3.232</h2.version>
        <postgresql.version>42.7.4</postgresql.version>

        <!-- Maven 插件版本 -->
        <lombok.version>1.18.44</lombok.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <spring-boot-maven-plugin.version>3.5.0</spring-boot-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
        <license-maven-plugin.version>5.1.1</license-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 依赖 BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Redis -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot3-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- OpenAPI 文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- 安全框架 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- 可观测性 -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-tracing-bridge-otel</artifactId>
                <version>${micrometer.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-otlp</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-logging</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>

            <!-- 测试工具 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>h2</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>elasticsearch</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>toxiproxy</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>

            <!-- 安全扫描 -->
            <dependency>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>10.0.4</version>
            </dependency>

            <!-- Flyway -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-h2</artifactId>
                <version>${flyway.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 编译插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- Surefire 测试插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                        <excludes>
                            <exclude>**/*IntegrationTest.java</exclude>
                            <exclude>**/*E2ETest.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!-- Failsafe 集成测试插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*IntegrationTest.java</include>
                            <include>**/*E2ETest.java</include>
                        </includes>
                        <!-- 显式将主应用编译输出目录加入 failsafe fork 类路径。
                             背景：spring-boot:repackage 在 package 阶段把主 artifact 替换为
                             fat jar（应用类位于 BOOT-INF/classes/，无法按根路径加载）。
                             failsafe 在 integration-test 阶段（package 之后）运行时，
                             其 fork 类路径会使用该 fat jar 作为主类源（取代 target/classes），
                             导致应用类 NoClassDefFoundError、JUnit 测试发现失败。
                             补充 target/classes 确保应用类可被加载，且不改变构建产物
                             （主 jar 仍为可执行 fat jar）。 -->
                        <additionalClasspathElements>
                            <additionalClasspathElement>${project.build.outputDirectory}</additionalClasspathElement>
                        </additionalClasspathElements>
                    </configuration>
                    <!-- 绑定 integration-test 与 verify goal 到对应生命周期阶段。
                         failsafe 的 goal 不在 Maven 默认生命周期绑定中，
                         必须显式声明 executions 才能在 mvn install/verify 时触发。 -->
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- JAR 打包插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>

                <!-- Source 插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>

                <!-- Javadoc 插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <charset>UTF-8</charset>
                        <encoding>UTF-8</encoding>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>

                <!-- Spring Boot 插件 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot-maven-plugin.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!-- JaCoCo 覆盖率插件 -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <configuration>
                        <excludes>
                            <!-- 排除实体类 -->
                            <exclude>**/entity/**</exclude>
                            <!-- 排除数据对象 -->
                            <exclude>**/dataobject/**</exclude>
                            <!-- 排除 DTO -->
                            <exclude>**/dto/**</exclude>
                            <!-- 排除枚举 -->
                            <exclude>**/*Enum*</exclude>
                            <exclude>**/enums/**</exclude>
                            <!-- 排除异常类 -->
                            <exclude>**/*Exception*</exclude>
                            <!-- 排除配置类（*Config* 命名的装配/配置类；业务服务已通过改名避开该规则，
                                 如缓存一致性服务 CacheInvalidationService/CacheVersionChecker 不匹配此模式） -->
                            <exclude>**/*Config*</exclude>
                            <exclude>**/*Properties*</exclude>
                            <!-- 排除初始化类（*Initializer* 命名的启动初始化组件） -->
                            <exclude>**/*Initializer*</exclude>
                            <!-- 排除应用主类 -->
                            <exclude>**/*Application*</exclude>
                            <!-- 排除 Converter -->
                            <exclude>**/*Converter*</exclude>
                        </excludes>
                    </configuration>
                    <!-- 注意：executions 统一声明在 <build><plugins>（prepare-agent/report/report-aggregate），
                         此处不声明 executions，避免按 execution id 合并时与 build/plugins 的
                         无 id execution（默认 id=default-prepare-agent）并存导致 prepare-agent 重复执行。 -->
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 解析 ${revision} 为实际版本 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo 覆盖率插件（继承所有模块：prepare-agent + report）。
                 各模块只做单模块覆盖率；report-aggregate 聚合报告由 gateway-coverage
                 模块在自身 build/plugins 单独声明（避免每个子模块 verify 阶段都继承执行
                 一次聚合，产生空/部分报告误导取数——权威聚合报告在 gateway-coverage）。
                 excludes 等 configuration 从 pluginManagement 继承（此处不写 configuration，
                 避免覆盖 pluginManagement 的 excludes 配置）。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 开源协议头校验插件 -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <configuration>
                    <header>${maven.multiModuleProjectDirectory}/config/license-header.txt</header>
                    <properties>
                        <inceptionYear>2025</inceptionYear>
                        <currentYear>2026</currentYear>
                        <owner>codingas.com</owner>
                    </properties>
                    <includes>
                        <include>**/*.java</include>
                        <include>**/*.xml</include>
                        <include>**/*.yml</include>
                        <include>**/*.yaml</include>
                        <include>**/*.properties</include>
                    </includes>
                    <excludes>
                        <exclude>**/target/**</exclude>
                        <exclude>**/generated/**</exclude>
                        <exclude>**/db/migration/**</exclude>
                        <exclude>**/resources/catalog/**</exclude>
                        <exclude>**/resources/data/**</exclude>
                        <exclude>**/resources/metadata/**</exclude>
                        <exclude>**/static/**</exclude>
                    </excludes>
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                        <xml>XML_STYLE</xml>
                        <yml>SCRIPT_STYLE</yml>
                        <yaml>SCRIPT_STYLE</yaml>
                        <properties>SCRIPT_STYLE</properties>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Profile 定义 -->
    <profiles>
        <!-- 开发环境 -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring.profiles.active>dev</spring.profiles.active>
            </properties>
        </profile>

        <!-- 测试环境 -->
        <profile>
            <id>test</id>
            <properties>
                <spring.profiles.active>test</spring.profiles.active>
            </properties>
        </profile>

        <!-- 生产环境 -->
        <profile>
            <id>prod</id>
            <properties>
                <spring.profiles.active>prod</spring.profiles.active>
            </properties>
        </profile>
    </profiles>

    <!-- SCM 配置 -->
    <scm>
        <connection>scm:git@github.com:stvliu/llm-gateway.git</connection>
        <developerConnection>scm:git@github.com:stvliu/llm-gateway.git</developerConnection>
        <url>https://github.com/stvliuy/llm-gateway</url>
    </scm>
</project>
