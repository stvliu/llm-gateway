<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codingas.gateway</groupId>
        <artifactId>gateway-project</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>gateway-boot</artifactId>
    <packaging>jar</packaging>

    <name>Gateway Boot</name>
    <description>LLM-Gateway Backend Module - Core API Gateway Services</description>

    <dependencies>
        <!-- 横切底座模块（BaseEntity/异常/工具/事件/通用枚举，纯横切） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 抽象协议层模块（Canonical IR + ProtocolAdapter SPI + 协议契约 DTO） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-protocol</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 协议能力插件（通过 AutoConfiguration + @ConditionalOnProperty 启用） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-protocol-openai</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-protocol-anthropic</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Gemini 协议示例插件（验证插件化可扩展性） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-protocol-gemini</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 供给域 starter（AutoConfiguration 显式装配，@ConditionalOnProperty 可关） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-provider-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 身份与访问管理域 starter（IAM 域装配入口） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-iam-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 用量管控域 starter（Usage 域装配入口） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-usage-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 安全与威胁域 starter（Security 域装配入口） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-security-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 韧性域 starter（Resilience 域装配入口） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-resilience-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 审计追溯域 starter（Audit 域装配入口） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-audit-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 告警通知域 starter（Alert 域装配入口） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-alert-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 模型代理域 starter（Proxy 域装配入口） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-proxy-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 聚合统计域 starter（Stats 域装配入口） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-stats-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- HTTP 承载层模块（Controller/Interceptor/Advice，@AutoConfiguration 装配） -->
        <dependency>
            <groupId>com.codingas.gateway</groupId>
            <artifactId>gateway-web</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Spring Boot Web MVC (同步) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- HTTP 客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${okhttp.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Flyway 数据库迁移 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Cache -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Spring Data Redis（会话亲和存储生产实现） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Caffeine 本地缓存 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Logback 日志 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>

        <!-- PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 Database -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Micrometer Prometheus -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- OpenTelemetry API -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>

        <!-- Sa-Token 安全框架 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit 架构测试（COLA 分层依赖约束，模块化重构 Phase 0） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 编译插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Surefire 测试插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- Failsafe 集成测试插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>

            <!-- Spring Boot 插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Flyway 数据库迁移插件 -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway.version}</version>
                <configuration>
                    <!-- 数据库连接配置（通过 Profile 覆盖） -->
                    <url>${flyway.url}</url>
                    <user>${flyway.user}</user>
                    <password>${flyway.password}</password>
                    <driver>${flyway.driver}</driver>
                    <!-- 迁移脚本位置（通过 Profile 配置不同数据库的脚本） -->
                    <locations>
                        <location>${flyway.locations}</location>
                    </locations>
                    <!-- 清理数据库（仅开发环境使用） -->
                    <cleanDisabled>true</cleanDisabled>
                    <!-- 校验迁移脚本 -->
                    <validateOnMigrate>true</validateOnMigrate>
                    <!-- 允许乱序迁移 -->
                    <outOfOrder>false</outOfOrder>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.h2database</groupId>
                        <artifactId>h2</artifactId>
                        <version>${h2.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>

        <!-- 默认属性值（H2 本地开发） -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>

    <!-- Profile 定义 -->
    <profiles>
        <!-- H2 本地开发环境（默认） -->
        <profile>
            <id>h2</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <flyway.url>jdbc:h2:file:${project.basedir}/../data/gateway;MODE=PostgreSQL</flyway.url>
                <flyway.user>sa</flyway.user>
                <flyway.password></flyway.password>
                <flyway.driver>org.h2.Driver</flyway.driver>
                <flyway.locations>classpath:db/migration</flyway.locations>
            </properties>
        </profile>

        <!-- PostgreSQL 环境 -->
        <profile>
            <id>postgresql</id>
            <properties>
                <flyway.url>${env.DB_URL}</flyway.url>
                <flyway.user>${env.DB_USERNAME}</flyway.user>
                <flyway.password>${env.DB_PASSWORD}</flyway.password>
                <flyway.driver>org.postgresql.Driver</flyway.driver>
                <flyway.locations>filesystem:docs/db/postgresql</flyway.locations>
            </properties>
        </profile>

        <!-- Docker 构建 -->
        <profile>
            <id>docker</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build-image</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 裸机部署打包：mvn process-resources -Ppkg 触发，替换 scripts/bin/conf 占位符到 target/packaging -->
        <!-- 占位符 ${pkg.name}/${pkg.user}/${pkg.installFolder}/${pkg.logFolder} 由 filters/unix.properties + 本 profile properties 替换 -->
        <!-- 后续 build.sh 调 ./gradlew buildDeb buildRpm zipWin -PprojectBuildDir=../../gateway-boot/target/packaging -->
        <profile>
            <id>pkg</id>
            <properties>
                <pkg.name>llmgateway</pkg.name>
                <pkg.user>llmgateway</pkg.user>
                <pkg.installFolder>/opt/llmgateway</pkg.installFolder>
                <pkg.unixLogFolder>/var/log/${pkg.name}</pkg.unixLogFolder>
                <main.dir>${project.basedir}/..</main.dir>
                <pkg.process-resources.phase>process-resources</pkg.process-resources.phase>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <!-- 复制 scripts/（control 脚本 + template.service）到 target/packaging/scripts -->
                            <execution>
                                <id>copy-pkg-scripts</id>
                                <phase>${pkg.process-resources.phase}</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/packaging/scripts</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${main.dir}/deployments/package/scripts</directory>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                    <filters>
                                        <filter>${main.dir}/deployments/package/filters/unix.properties</filter>
                                    </filters>
                                </configuration>
                            </execution>
                            <!-- 复制 bin/llmgateway.sh 到 target/packaging/bin -->
                            <execution>
                                <id>copy-pkg-bin</id>
                                <phase>${pkg.process-resources.phase}</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/packaging/bin</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${main.dir}/deployments/package/bin</directory>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                    <filters>
                                        <filter>${main.dir}/deployments/package/filters/unix.properties</filter>
                                    </filters>
                                </configuration>
                            </execution>
                            <!-- 复制 conf/llmgateway.conf 到 target/packaging/conf -->
                            <execution>
                                <id>copy-pkg-conf</id>
                                <phase>${pkg.process-resources.phase}</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/packaging/conf</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${main.dir}/deployments/package/conf</directory>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                    <filters>
                                        <filter>${main.dir}/deployments/package/filters/unix.properties</filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>
</project>
