<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codingas.gateway.proxy</groupId>
        <artifactId>gateway-proxy-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>com.codingas.gateway.proxy</groupId>
    <artifactId>gateway-proxy</artifactId>
    <packaging>jar</packaging>
    <name>Gateway Proxy</name>
    <description>模型代理域：ChatDispatch 调度 / routing / invoker / 协议转换门面（由 application.proxy + application.protocol.conversion 迁入）</description>
    <dependencies>
        <!-- 横切底座 -->
        <dependency>
            <groupId>com.codingas.gateway.common</groupId>
            <artifactId>gateway-common</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 抽象协议层（ProtocolConversionFacade 依赖 Canonical IR + ProtocolAdapter SPI + 契约） -->
        <dependency>
            <groupId>com.codingas.gateway.protocol</groupId>
            <artifactId>gateway-protocol</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 供给域（调度依赖 Channel/Model/Upstream/RoutingContext） -->
        <dependency>
            <groupId>com.codingas.gateway.provider</groupId>
            <artifactId>gateway-provider</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 身份与访问管理域（依赖 Application/ApplicationChannel/Identity） -->
        <dependency>
            <groupId>com.codingas.gateway.iam</groupId>
            <artifactId>gateway-iam</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 用量管控域（调度发 TokenUsedEvent） -->
        <dependency>
            <groupId>com.codingas.gateway.usage</groupId>
            <artifactId>gateway-usage</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 审计追溯域（调度写 CallLog） -->
        <dependency>
            <groupId>com.codingas.gateway.audit</groupId>
            <artifactId>gateway-audit</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 韧性域（依赖 ChannelEndpointCircuitBreakerManager） -->
        <dependency>
            <groupId>com.codingas.gateway.resilience</groupId>
            <artifactId>gateway-resilience</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Spring Web MVC（ModelExperienceService 使用 SseEmitter 流式响应；框架依赖，非跨域依赖） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- Micrometer（调度指标监控） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- Jackson（ProtocolStreamConverter 流式转换） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
